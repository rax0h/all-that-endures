{
  "name": "All That Endures",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}:${containerWorkspaceFolder}/simulation"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r simulation/requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "simulation/tests"
        ]
      }
    }
  }
}
